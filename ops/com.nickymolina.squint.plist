<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by ops/install.sh, which fills in __PROJECT__ and __HOME__. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nickymolina.squint</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PROJECT__/server/.venv/bin/squint-server</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__PROJECT__/server</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>SQUINT_MODE</key>
		<string>preview</string>
		<key>SQUINT_REQUIRE_PASSWORD</key>
		<string>0</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/squint/squint.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/squint/squint.error.log</string>
</dict>
</plist>
