<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by ops/install-nightly.sh, which fills in __PROJECT__ and __HOME__.
     Runs ops/nightly.sh every night at 23:00; the window (23:00-09:30) is set in ops/nightly.sh only.
     If the Mac was asleep at 23:00, launchd starts it on wake; outside the window it just exits. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nickymolina.squint-nightly</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>__PROJECT__/ops/nightly.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__PROJECT__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__HOME__/.local/bin:__HOME__/.local/node/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>23</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<!-- Standard, not Background: Background QoS made training 4x slower whenever other work ran (2026-10-25: 24-28 s/step vs 6 s/step). nightly.py's guards still yield to Squint users. -->
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ExitTimeOut</key>
	<integer>180</integer>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/squint/nightly.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/squint/nightly.log</string>
</dict>
</plist>
