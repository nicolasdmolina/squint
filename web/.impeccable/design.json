  "narrative": {
    "northStar": "The optician's reading card",
    "overview": "Squint reads text the way an optician reads eyes: one card held at reading distance, a two-sided duochrome comparison where neither side is the bad side, and a lens for looking closer. Graphite carries every control; colour appears only where there is evidence. It refuses the detector default of a red percentage gauge and an alarm highlighter over a white SaaS card.",
    "keyCharacteristics": [
      "One reading card per view",
      "Teal/rose duochrome only on evidence, always with a non-colour cue",
      "Graphite controls; errors in ink, never red",
      "Archivo for Squint, Source Serif 4 for the writer",
      "One moving element per view"
    ],
    "rules": [
      {
        "name": "The Evidence-Only Rule",
        "body": "Teal and rose never touch a control, heading or error.",
        "section": "colors"
      },
      {
        "name": "The Two-Cues Rule",
        "body": "Every colour meaning repeats without colour: solid vs dotted underline, stripes, labels.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Archivo for the interface, Source Serif for the person. No caps, mono or eyebrows.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do put the ChatGPT gap beside every verdict and atop Accuracy",
      "Do cap h1 at 28px (24px phone)",
      "Do render only what /api/accuracy returns"
    ],
    "donts": [
      "Don't use red or amber for errors or for AI",
      "Don't add uppercase eyebrows, mono numerals or card grids",
      "Don't animate more than one element per view"
    ]
  }
